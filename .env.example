# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag

# Embeddings
EMBEDDER_PROVIDER=openai
EMBEDDER=voyageai/voyage-4
EMBEDDING_SPACE=1024

EMBED_BATCH_SIZE=128

# LLM
LLM_PROVIDER=openai
LLM=deepseek/deepseek-v4.1-flash

JUDGE=openai/gpt-6-luna-pro

OPENAI_BASE_URL=https://routerai.ru/api/v1
OPENAI_API_KEY=

RERANKER_PROVIDER=routerai
RERANKER=voyageai/rerank-3-lite

# vector | bm25 | hybrid
RETRIEVAL_MODE=hybrid
# для hybrid: score = VECTOR_WEIGHT/(RRF_K + rank_vec) + BM25_WEIGHT/(RRF_K + rank_bm25)
RRF_K=60
VECTOR_WEIGHT=1.0
BM25_WEIGHT=1.0
